# Бинарники
*.exe

# Артефакты запусков
/output_*.txt
*.eml

# Данные
INS_Data/

# Каталоги сборки
/build/
/build_debug/
/out/
/out_first_run/
/cmake-build-*/

# Крупные входные данные и внешний референсный датасет
# (тесты паритета/формата пропускаются, если данных нет на диске)
/data/
/run_hk/
/ITT_Students-Katya/

# Архивы и портативный пакет (получаются на этапе деплоя)
*.zip
/dist/

# Сформированные отчёты (docx)
/Report_*.docx

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Временные каталоги подбора КФ (tools/kalman_tuner)
/tools/kalman_tuner/temp_tune*/
/tools/kalman_tuner/dbg_*/
/tools/kalman_tuner/*.pyc

# PDF-отчёты прогонов и подбора (в репозиторий не кладём; конвенция — reports/README.md)
/reports/**/*.pdf

# Артефакты прогонов: result.txt/reference.txt/errors.txt пишутся в tools/,
# лог защиты СНС (gnss_guard.txt) — рядом с result.txt.
/tools/*.txt
**/tools/*.txt
**/gnss_guard.txt
